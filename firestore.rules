rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function getProfile() { return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data; }
    function isActivo() { return isSignedIn() && getProfile().status == 'ACTIVO'; }
    function isAdmin() { return isActivo() && getProfile().role == 'admin'; }
    function isConsultant() { return isActivo() && (getProfile().role == 'consultant' || getProfile().role == 'admin'); }
    function isRedator() { return isActivo() && (getProfile().role == 'redator' || getProfile().role == 'admin'); }
    function isUser() { return isActivo() && getProfile().role == 'user'; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    // --- Collection: Profiles ---
    function isValidProfile(data) {
      return data.email is string &&
             data.role in ['user', 'consultant', 'redator', 'admin'] &&
             data.status in ['PENDENTE', 'ACTIVO', 'BLOQUEADO', 'ELIMINADO'] &&
             data.displayName is string;
    }

    match /profiles/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && 
                     request.resource.data.role == 'user' && 
                     request.resource.data.status == 'PENDENTE';
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && 
         request.resource.data.role == resource.data.role && 
         request.resource.data.status == resource.data.status) || 
        isAdmin()
      ) && isValidProfile(request.resource.data);
    }

    // --- Collection: News ---
    function isValidNews(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.subtitle is string && data.subtitle.size() <= 400 &&
             data.content is string && data.content.size() <= 50000 &&
             data.category is string && data.category.size() <= 100 &&
             data.isHighlight is bool &&
             data.status in ['published', 'draft', 'desativado'];
    }

    match /news/{newsId} {
      allow read: if (resource.data.status == 'published') || isRedator();
      allow write: if isRedator() && isValidNews(request.resource.data);
      allow delete: if isAdmin();
    }

    // --- Collection: Chats ---
    match /chats/{chatId} {
      allow create: if isSignedIn();
      allow read: if isConsultant() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isConsultant() || (isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage', 'updatedAt', 'status']));
    }

    // --- Collection: Messages ---
    match /chats/{chatId}/messages/{msgId} {
      allow read, list: if isConsultant() || (isSignedIn() && get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid);
      allow create: if isSignedIn() && (isConsultant() || get(/databases/$(database)/documents/chats/$(chatId)).data.userId == request.auth.uid);
    }
  }
}
